[user]
	name = whu-pzhang
	email = pzhang@whu.edu.cn
[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
[push]
	default = simple
[colo]
	ui = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
